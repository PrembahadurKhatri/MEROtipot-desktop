"use client"

import { Content } from "next/font/google";
import "./globals.css";
import { useEffect, useState } from "react";

export default function Home() {
  const [notes, setNotes] = useState([]);
const [isCreating, setIsCreating] = useState(false);
const [selectnote,setSelectnote]=useState(null);
const [files,setFiles]=useState([]);
const [selectedFile, setSelectedFile] = useState(null);
const [search, setSearch] = useState("");
const [filter, setFilter] = useState("all");
  useEffect(() => {//react hook component render bhasi run hunxa
   
    const savednotes = localStorage.getItem("notes"); //saved notes lai read garna khojexa
    if (savednotes) { //saved notes xa bhaney 
      setNotes(JSON.parse(savednotes));//teslai json bata feri js array of object ma convert garni  
    }
  }, []);//[] ek choti matra run garni

  const handlecreatenote = () => {
         if(isCreating){
        alert("Note is already created.")
        return;//stop if note is already created
      }
    const newnotes = { id: Date.now(), title: "Create New notes", topic: "", content: "" };//newnotes create garyo 
     setNotes(prev => [...prev, newnotes]);
    setSelectnote(newnotes);
    setIsCreating(true);
    }

  
  const handledeletenote = (id) => {
    setNotes(prevnotes => {
      const updated = prevnotes.filter(note => note.id !== id);
      localStorage.setItem("notes", JSON.stringify(updated));
      setSelectedFile(null);
      setSelectnote(null);
       setIsCreating(false);
      return updated;
     
    })
  }
  const handlesavenotes = () => {
    if(!selectnote) return;
    const updated =[...notes];//clones note array
    //chech if note already exist
    const index=updated.findIndex((n) => n.id ===selectnote.id);
    if(index!== -1){
      updated[index]=selectnote;//update existing
    }
    else{
      updated.push(selectnote);//add new
    }
    setNotes(updated);
    localStorage.setItem("notes", JSON.stringify(updated));
    alert("Saved Notes");
    setSelectnote(null);
    setIsCreating(false);
  }
  const handlefile = (e) => {
    const selectfiles = Array.from(e.target.files);//convert file list to array
    if(selectfiles.length > 0){
      setFiles(prevfiles => [...prevfiles,...selectfiles]);//append to existing
    }
    }
const filteredFiles = files.filter((file) => {
  const matchSearch = file.name.toLowerCase().includes(search.toLowerCase());

  if (filter === "pdf") return matchSearch && file.type === "application/pdf";
  if (filter === "image") return matchSearch && file.type.startsWith("image/");

  return matchSearch;
});
const toggleStar = (index) => {
  const updated = [...files];
  updated[index].star = !updated[index].star;
  setFiles(updated);
};
const removeFile = (index) => {
  const updated = files.filter((_, i) => i !== index);
  setFiles(updated);
};
  return (
    <div>
      <div className="gridContainer">
        <div >
          <h1 className="first" >
            <img src="notes.png" alt="logo" width={40} height={40} />
            Mero तिपोट</h1>
          <div className="store">
            <h1 style={{ color: "purple", textAlign: "center", padding: 8 }}>Notes</h1>
              
                 <div  >
                  <ol >
                    {notes.map((note) => (
                      <li className="notebox" key={note.id}>
                        <span 
                        style={{cursor:"pointer"}} onClick={() => {
                          setSelectnote(note);
                          setSelectedFile(null);
                        }}>{note.topic || "untitled"} </span></li>
                    ))}
                  {files.map((file,index) => (
                 <li className="notebox" key={index}>
                <span  onClick={() => {setSelectedFile(file); setSelectnote(null);}}  style={{cursor:"pointer"}}>{file.name}</span> </li> 
         ))}   
            </ol>
                  
            </div>
             
            </div>
          <div className="btn-gap">
            <button className="btn" style={{ paddingLeft: "80px" }} onClick={handlecreatenote}> + Create Notes  </button>
              <input type="file"
              id="fileupload"
              style={{display:"none"}}
              accept=".pdf,image/*"
              multiple // ✅ add this if multiple files are allowed
              onChange={handlefile}
              />
            <button className="btn"  onClick={() => document.getElementById("fileupload").click()}>
              <img src="https://cdn3.emoji.gg/emojis/7458-upload.png"
                width={20} height={20} alt="upload" />
              <span  >Upload PDF/Image</span>
            </button>
          </div>
        </div>


        <div className="second">
         {selectedFile ? (
          <div className="preview">
            <h2 className="head">{selectedFile.name}</h2>

            {/*Image */}
            {selectedFile.type.startsWith("image/")  && (
              <img className="images" src={URL.createObjectURL(selectedFile)} alt="preview" style={{maxWidth:"60%"}} />
            )}
            {selectedFile.type==="application/pdf" && (
               <iframe
          src={URL.createObjectURL(selectedFile)}
          width="100%"
          height="500px"
        ></iframe>
            )}
            <button className="Btns" onClick={() => setSelectedFile(null)}>Close</button>
          </div>
) :    selectnote ? (
            <div className="notesgrid">
             
                <div className="noteBox" key={selectnote.id}>
                  <h1 className="ais">{selectnote.title}</h1>
                  <div >
                    <h3 className="text">Title</h3>
                    <input type="text" placeholder="Enter title" className="inputt"
                      value={selectnote.topic}
                      onChange={(e) => {
                        setSelectnote({...selectnote,topic:e.target.value})
                      }}
                    />
                  </div>
                  <div >
                    <h3 className="text">Content</h3>
                    <textarea className="texta" placeholder="Start typing your notes here..."
                      value={selectnote.content}
                      onChange={(e) => {
                       setSelectnote({...selectnote, content:e.target.value})
                      }}
                    ></textarea></div>

                  <div className="button" style={{ textAlign: "end", paddingRight: 25 }}>
                    <button className="Btns" onClick={() => handledeletenote(selectnote.id)}> Delete Note  </button>
                    <button className="Btns" onClick={handlesavenotes}> Save Note  </button>
                  </div>
                </div>
            </div>
          ) : <div className="page">
            <img src="note.webp" alt="logo" width={700} height={500} className="img" />
            <h3 className="hero">Your Academic Hub</h3>
            <p className="heros">Select a note to view, upload a new PDF, or start asking AI questions across all your materials.</p>
            <div className="button">
              <button className="Btns" onClick={handlecreatenote}> Write Note  </button>
              
              <input type="file"
              id="fileupload"
              style={{display:"none"}}
              accept=".pdf,image/*"
              multiple // ✅ add this if multiple files are allowed
              onChange={handlefile}
              /><button className="Btns" onClick={() => document.getElementById("fileupload").click()}>
                Upload Material
              </button>
         
            </div>
          </div>
}
        </div>

<div className="third">
  <div className="we">
    <img src="ai.png" width={40} />
    <h1 className="ai">Document Hub</h1>
  </div>

  {/* SEARCH */}
  <input
    className="textai"
    placeholder="Search files..."
    value={search}
    onChange={(e) => setSearch(e.target.value)}
  />

  {/* FILTER BUTTONS */}
  <div className="filters">
    <button onClick={() => setFilter("all")} className="but">All</button>
    <button onClick={() => setFilter("pdf")} className="but">PDF</button>
    <button onClick={() => setFilter("image")} className="but">Images</button>
  </div>

  {/* FILE LIST */}
  <div className="fileList">
    {filteredFiles.map((file, index) => (
      <div className="fileCard" key={index}>
        <p
        style={{ cursor: "pointer" }}
        onClick={() => {
          setSelectedFile(file);
          setSelectnote(null); // deselect note
        }}
      >
        {file.name}
      </p>

        <div className="actions">
          <button onClick={() => toggleStar(index)}>
            {file.star ? "⭐" : "☆"}
          </button>

          <button onClick={() => removeFile(index)} >🗑</button>
        </div>
      </div>
    ))}
  </div>
</div>
  </div>
</div>
    
    
  );
}